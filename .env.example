# ==============================================================================
# UDRRMS CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=False

# JWT Security
JWT_SECRET=udrrms_super_secure_secret_key_disaster_ops_2026_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Engine Selection
# Set to 'false' to connect to target Oracle Database instance
USE_SQLITE_DEV=true

# Oracle Database Target Configuration (When USE_SQLITE_DEV=false)
ORACLE_USER=udrrms_admin
ORACLE_PASSWORD=YourSecureOraclePassword123!
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=xe

# SQLite Fallback Configuration (When USE_SQLITE_DEV=true)
SQLITE_URL=sqlite:///./udrrms.db
